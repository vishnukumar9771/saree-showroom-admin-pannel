# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Optional — enables Supabase Auth & PostgreSQL persistence)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ADMIN AUTHENTICATION (Server-side only — never prefix with VITE_)
# Leave empty in preview to claim the initial Super Admin password via /admin/login
ADMIN_BOOTSTRAP_PASSCODE=""
SESSION_SECRET=""
